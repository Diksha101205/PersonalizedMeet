# Copy this file to .env and fill values locally. Do not commit real secrets.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=
# Optional when ffmpeg is not available on PATH. Use the full path to ffmpeg.exe on Windows.
FFMPEG_PATH=ffmpeg
# Comma-separated words to exclude from deterministic topic extraction.
TOPIC_STOP_WORDS=about,after,again,also,and,are,been,being,but,can,could,for,from,have,into,just,more,not,our,out,should,that,the,their,there,they,this,was,were,what,when,will,with,would,you,your
# A word must appear at least this many times to be returned as a topic.
TOPIC_MIN_OCCURRENCES=2
# Comma-separated phrases used to find source-backed decisions and action items.
DECISION_PATTERNS=decided,approved,agreed,finalized,confirmed,will proceed,we will,it was decided
ACTION_ITEM_PATTERNS=will do,need to,needs to,should,assigned to,responsible for,please,by tomorrow,by Monday
# Optional: restrict the service to files under these roots. Separate multiple paths with ; on Windows.
ALLOWED_RECORDING_ROOTS=
